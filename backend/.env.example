# MongoDB Atlas. Replace <db_password> with your real DB user password.
# If the password has special characters (@ : / ? # etc.), URL-encode them (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=DailyPilot
DB_NAME=dailypilot

PORT=3000
JWT_SECRET=
ADMIN_EMAIL=admin@dailypilot.local
ADMIN_PASSWORD=Admin@12345
# Only needed when the frontend is hosted on another origin (e.g. https://app.example.com). Empty = same origin.
CORS_ORIGIN=
